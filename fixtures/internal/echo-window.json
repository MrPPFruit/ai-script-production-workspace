  "versions": [
    {
      "id": "version-v1",
      "projectId": "project-echo-window",
      "label": "V1",
      "createdAt": "2026-08-28T00:00:00.000Z",
      "sourceDigest": "2f8f3202fe20818bdfd3644febd35b513177f0b2f3eeff6ae0527231cf91cb62",
      "scenes": [
        {
          "id": "version-v1-s1",
          "versionId": "version-v1",
          "ordinal": 1,
          "heading": "1. 内景·XR影棚·夜",
          "text": "LED墙循环播放一条湿漉漉的旧巷。地面铺着黑色反光板，雨声从四角音箱里持续传来。林乔站在一把红色雨伞下，伞尖压着一张折起的通行证。蓝色频闪掠过她的脸。\n\n陈默从控制台抬头，按停雨声。屏幕上只剩一扇亮着的窗。\n\n陈默：雨声停了，窗口还在。你确定通行证是在现场找到的？\n\n林乔把通行证递过去。通行证背面写着一串坐标。\n\n林乔：坐标指向这面墙里的巷口。",
          "sourceRange": {
            "start": 0,
            "end": 187
          }
        },
        {
          "id": "version-v1-s2",
          "versionId": "version-v1",
          "ordinal": 2,
          "heading": "2. 内景·虚拟巷口布景·夜",
          "text": "同一把红色雨伞靠在生锈的路牌旁。LED墙上的雨幕映进积水，巷口尽头的窗一明一灭。林乔沿着地上的绿色胶带走到窗前，陈默跟在她身后。\n\n一阵短促的故障声从窗内传出。窗玻璃浮出通行证上的坐标，随后熄灭。\n\n陈默：不是投影故障。有人把坐标写进了雨幕。\n\n林乔抬起雨伞，遮住窗前的反光。",
          "sourceRange": {
            "start": 189,
            "end": 343
          }
        },
        {
          "id": "version-v1-s3",
          "versionId": "version-v1",
          "ordinal": 3,
          "heading": "3. 内景·XR影棚控制区·夜",
          "text": "红色雨伞横放在控制台上。林乔把通行证贴近监视器，陈默调亮屏幕。四角音箱再次响起雨声，却比刚才少了一拍。\n\n监视器里的窗被拉近，窗内出现林乔自己的背影。蓝色频闪突然熄灭，影棚只剩雨声。\n\n林乔：它不是在重播巷口，它在等我回头。\n\n陈默关掉监视器。雨声没有停止。",
          "sourceRange": {
            "start": 345,
            "end": 491
          }
        }
      ]
    },
    {
      "id": "version-v2",
